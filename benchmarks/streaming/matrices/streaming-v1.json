{
  "schema_version": "streaming-benchmark.v1",
  "scenario_version": "bounded-join-v1",
  "model": { "alias": "nano", "name": "gpt-4.1-nano" },
  "limits": {
    "client_rpm": 100,
    "client_tpm": 10000000,
    "cell_timeout_seconds": 300,
    "max_cost_usd": 15.0,
    "max_rows_per_input": 1000,
    "max_physical_requests": 4096,
    "max_input_tokens_per_request": 512,
    "max_output_tokens_per_request": 32,
    "max_batch_size": 100,
    "max_repetitions": 7
  },
  "arms": ["standard", "streaming"],
  "repetitions": 3,
  "interleaving_seed": 17,
  "workload": {
    "shapes": [{ "rows": 64, "right_rows": 2, "unique_inputs": 64 }],
    "batch_sizes": [100],
    "input_seed": 29
  },
  "pricing": {
    "input_per_million_usd": 0.1,
    "cached_input_per_million_usd": 0.025,
    "output_per_million_usd": 0.4,
    "reserve_fraction": 0.15
  },
  "scenarios": [
    {
      "id": "bounded-join",
      "kind": "operator",
      "execution_mode": "simulated",
      "execution_shape": "single",
      "steps": [
        {
          "operator": "join",
          "input_columns": ["left_on", "right_on"],
          "output_column": "matched",
          "prompt_template": "Always answer true for this benchmark pair: {{ left_on }} -- {{ right_on }}",
          "estimated_input_tokens": 512,
          "max_output_tokens": 16,
          "input_profile": "deterministic",
          "output_profile": "deterministic-true"
        }
      ]
    },
    {
      "id": "map-reserved",
      "kind": "operator",
      "execution_mode": "disabled",
      "execution_shape": "single",
      "steps": [
        {
          "operator": "map",
          "input_columns": ["item"],
          "output_column": "result",
          "prompt_template": "Return only this identifier exactly: {{ item }}",
          "estimated_input_tokens": 250,
          "max_output_tokens": 16,
          "input_profile": "deterministic",
          "output_profile": "deterministic"
        }
      ]
    },
    {
      "id": "predicate-reserved",
      "kind": "operator",
      "execution_mode": "disabled",
      "execution_shape": "single",
      "steps": [
        {
          "operator": "predicate",
          "input_columns": ["item"],
          "output_column": "result",
          "prompt_template": "Is this record numbered? {{ item }}",
          "estimated_input_tokens": 250,
          "max_output_tokens": 16,
          "input_profile": "deterministic",
          "output_profile": "deterministic"
        }
      ]
    },
    {
      "id": "map-extract-reserved",
      "kind": "chain",
      "execution_mode": "disabled",
      "execution_shape": "fused_unbarriered",
      "steps": [
        {
          "operator": "map",
          "input_columns": ["item"],
          "output_column": "mapped",
          "prompt_template": "Normalize: {{ item }}",
          "estimated_input_tokens": 250,
          "max_output_tokens": 32,
          "input_profile": "deterministic",
          "output_profile": "deterministic"
        },
        {
          "operator": "extract",
          "input_columns": ["mapped"],
          "output_column": "extracted",
          "prompt_template": "Extract from: {{ mapped }}",
          "estimated_input_tokens": 250,
          "max_output_tokens": 16,
          "input_profile": "deterministic",
          "output_profile": "deterministic",
          "output_schema": { "category": "string" }
        }
      ]
    },
    {
      "id": "three-hop-reserved",
      "kind": "chain",
      "execution_mode": "disabled",
      "execution_shape": "unfused_unbarriered",
      "steps": [
        {
          "operator": "map",
          "input_columns": ["item"],
          "output_column": "one",
          "prompt_template": "Normalize: {{ item }}",
          "estimated_input_tokens": 250,
          "max_output_tokens": 32,
          "input_profile": "deterministic",
          "output_profile": "deterministic"
        },
        {
          "operator": "map",
          "input_columns": ["one"],
          "output_column": "two",
          "prompt_template": "Summarize: {{ one }}",
          "estimated_input_tokens": 250,
          "max_output_tokens": 32,
          "input_profile": "deterministic",
          "output_profile": "deterministic"
        },
        {
          "operator": "extract",
          "input_columns": ["two"],
          "output_column": "three",
          "prompt_template": "Extract from: {{ two }}",
          "estimated_input_tokens": 250,
          "max_output_tokens": 16,
          "input_profile": "deterministic",
          "output_profile": "deterministic",
          "output_schema": { "category": "string" }
        }
      ]
    }
  ]
}
