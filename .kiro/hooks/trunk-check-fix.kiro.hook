{
  "enabled": true,
  "name": "Trunk Check & Fix",
  "description": "Automatically runs trunk check --fix when work is complete to find and fix linter issues, with capability to handle remaining unfixable issues",
  "version": "1",
  "when": {
    "type": "fileEdited",
    "patterns": [
      "src/**/*.py",
      "tests/**/*.py",
      "examples/**/*.py",
      "tools/**/*.py",
      "rust/src/**/*.rs",
      "*.py",
      "*.rs",
      "*.md",
      "*.yaml",
      "*.yml",
      "*.toml"
    ]
  },
  "then": {
    "type": "askAgent",
    "prompt": "Work on a task was completed.  Please run `trunk check --fix` to find and automatically fix any linter issues. If there are any issues that trunk cannot fix automatically, please review them and make the simple fixes yourself. Focus on common issues like formatting, unused imports, missing docstrings, or other style violations that can be easily resolved."
  }
}